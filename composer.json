{
    "name": "slimpay/school-sdk",
    "description": "Connect your school system to Slimpay: verify signed lookup requests, answer student/invoice lookups and handle payment webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["slimpay", "school", "payments", "webhook", "laravel", "nigeria"],
    "require": {
        "php": "^8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0"
    },
    "suggest": {
        "illuminate/support": "Required for the Laravel service provider and auto-registered routes (^10|^11|^12)."
    },
    "autoload": {
        "psr-4": { "Slimpay\\School\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Slimpay\\School\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Slimpay\\School\\Laravel\\SlimpayServiceProvider"]
        }
    },
    "scripts": { "test": "phpunit" },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
